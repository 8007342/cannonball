{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "qwen-image-edit-2511"},
        "inputs": {"unet_name": "qwen_image_edit_2511_fp8mixed.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "qwen-vl-text-encoder"},
        "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "qwen-image-vae"},
        "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "4": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "lightning-4step"},
        "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}},
  "5": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "shift"},
        "inputs": {"model": ["4", 0], "shift": 3.1}},
  "6": {"class_type": "LoadImage", "_meta": {"title": "init (clay/colour render or parent pick on the key colour)"},
        "inputs": {"image": "$init_image"}},
  "7": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "1mp init"},
        "inputs": {"image": ["6", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "8": {"class_type": "LoadImage", "_meta": {"title": "control (depth/normal pass; may be the init again)"},
        "inputs": {"image": "$control"}},
  "9": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "1mp control"},
        "inputs": {"image": ["8", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "10": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "$prompt"},
         "inputs": {"clip": ["2", 0], "vae": ["3", 0], "image1": ["7", 0], "image2": ["9", 0],
                    "prompt": "Repaint picture 1 as a hand-painted cartoon game sprite. Keep the same shape, outline, camera angle and proportions; picture 2 is its depth. Flat pure white background."}},
  "11": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "$negative_prompt"},
         "inputs": {"clip": ["2", 0], "vae": ["3", 0], "image1": ["7", 0], "prompt": ""}},
  "12": {"class_type": "VAEEncode", "_meta": {"title": "encode init"},
         "inputs": {"pixels": ["7", 0], "vae": ["3", 0]}},
  "13": {"class_type": "KSampler", "_meta": {"title": "$seed"},
         "inputs": {"model": ["5", 0], "positive": ["10", 0], "negative": ["11", 0], "latent_image": ["12", 0],
                    "seed": 1, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "14": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
         "inputs": {"samples": ["13", 0], "vae": ["3", 0]}},
  "15": {"class_type": "SaveImage", "_meta": {"title": "save rgb"},
         "inputs": {"images": ["14", 0], "filename_prefix": "scenic/edit-rgb"}},
  "16": {"class_type": "LoadRembgByBiRefNetModel", "_meta": {"title": "birefnet"},
         "inputs": {"model": "model.safetensors", "device": "AUTO", "dtype": "float32", "use_weight": false}},
  "17": {"class_type": "GetMaskByBiRefNet", "_meta": {"title": "matte"},
         "inputs": {"model": ["16", 0], "images": ["14", 0], "width": 1024, "height": 1024,
                    "upscale_method": "bilinear", "mask_threshold": 0.0}},
  "18": {"class_type": "MaskToImage", "_meta": {"title": "matte image"},
         "inputs": {"mask": ["17", 0]}},
  "19": {"class_type": "SaveImage", "_meta": {"title": "save matte"},
         "inputs": {"images": ["18", 0], "filename_prefix": "scenic/edit-matte"}}
}
