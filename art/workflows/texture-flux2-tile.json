{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "flux2-klein-4b"},
        "inputs": {"unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "qwen3-4b text encoder"},
        "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "flux2-vae"},
        "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 0], "text": "seamless top-down texture of worn grey asphalt"}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 0], "text": ""}},
  "6": {"class_type": "EmptyFlux2LatentImage", "_meta": {"title": "fixed 1024 canvas (roll crops assume 1024)"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "7": {"class_type": "KSampler", "_meta": {"title": "$seed"},
        "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0],
                   "seed": 1, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
        "inputs": {"samples": ["7", 0], "vae": ["3", 0]}},
  "9": {"class_type": "ImageCrop", "_meta": {"title": "top half"},
        "inputs": {"image": ["8", 0], "width": 1024, "height": 512, "x": 0, "y": 0}},
  "10": {"class_type": "ImageCrop", "_meta": {"title": "bottom half"},
         "inputs": {"image": ["8", 0], "width": 1024, "height": 512, "x": 0, "y": 512}},
  "11": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll v: bottom to top"},
         "inputs": {"destination": ["8", 0], "source": ["10", 0], "x": 0, "y": 0, "resize_source": false}},
  "12": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll v: top to bottom"},
         "inputs": {"destination": ["11", 0], "source": ["9", 0], "x": 0, "y": 512, "resize_source": false}},
  "13": {"class_type": "ImageCrop", "_meta": {"title": "left half"},
         "inputs": {"image": ["12", 0], "width": 512, "height": 1024, "x": 0, "y": 0}},
  "14": {"class_type": "ImageCrop", "_meta": {"title": "right half"},
         "inputs": {"image": ["12", 0], "width": 512, "height": 1024, "x": 512, "y": 0}},
  "15": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll h: right to left"},
         "inputs": {"destination": ["12", 0], "source": ["14", 0], "x": 0, "y": 0, "resize_source": false}},
  "16": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll h: left to right"},
         "inputs": {"destination": ["15", 0], "source": ["13", 0], "x": 512, "y": 0, "resize_source": false}},
  "17": {"class_type": "LoadImage", "_meta": {"title": "seam cross mask (white = repaint)"},
         "inputs": {"image": "$mask"}},
  "18": {"class_type": "ImageToMask", "_meta": {"title": "mask"},
         "inputs": {"image": ["17", 0], "channel": "red"}},
  "19": {"class_type": "VAEEncode", "_meta": {"title": "encode rolled"},
         "inputs": {"pixels": ["16", 0], "vae": ["3", 0]}},
  "20": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "seams only"},
         "inputs": {"samples": ["19", 0], "mask": ["18", 0]}},
  "21": {"class_type": "KSampler", "_meta": {"title": "seam repaint"},
         "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["20", 0],
                    "seed": 7, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 0.6}},
  "22": {"class_type": "VAEDecode", "_meta": {"title": "decode seamless"},
         "inputs": {"samples": ["21", 0], "vae": ["3", 0]}},
  "23": {"class_type": "SaveImage", "_meta": {"title": "save tile"},
         "inputs": {"images": ["22", 0], "filename_prefix": "scenic/tile"}}
}
