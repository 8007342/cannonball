{
  "template": "silo",
  "notes": "Farm storage: 'stave' = tall concrete/tile silo with dome; 'bin' = corrugated steel grain bin with cone roof. n copies along X.",
  "view": {"pitch": 8, "yaw": 30},
  "params": {"style": "stave", "n": 1, "r": 2.6, "h": 16, "gap": 1.0, "body": "#d8d2c4", "band": "#b9b2a4", "dome": "#8f9aa3", "chute": "#a8322a"},
  "derived": {"pitch_x": "2*r + gap"},
  "parts": [
    {"repeat": {"k": "range(n)"}, "let": {}, "at": ["(k - (n-1)/2) * pitch_x", "0", 0], "parts": [
      {"p": "cyl", "r": "r", "h": "h", "seg": 20, "c": "body"},
      {"if": "style == 'stave'", "parts": [
        {"repeat": {"j": "range(int(h/2.2))"}, "p": "cyl", "r": "r+0.05", "h": 0.12, "seg": 20, "at": [0, 0, "1.2 + j*2.2"], "c": "band"},
        {"p": "sphere", "r": "r*1.02", "half": true, "seg": 20, "at": [0, 0, "h"], "c": "dome"},
        {"p": "box", "size": [0.9, 0.6, "h"], "at": ["-r*0.55", "-r*0.85", 0], "rot": [0, 0, -30], "c": "chute"},
        {"p": "box", "size": [1.0, 0.8, 1.0], "at": ["-r*0.55", "-r*0.85", "h"], "rot": [0, 0, -30], "c": "chute"}
      ]},
      {"if": "style == 'bin'", "parts": [
        {"repeat": {"j": "range(int(h/0.9))"}, "p": "cyl", "r": "r+0.04", "h": 0.08, "seg": 24, "at": [0, 0, "0.45 + j*0.9"], "c": "band"},
        {"p": "cyl", "r": "r+0.15", "r2": 0.35, "h": "r*0.75", "seg": 24, "at": [0, 0, "h"], "c": "dome"},
        {"p": "cyl", "r": 0.4, "h": 0.5, "seg": 10, "at": [0, 0, "h + r*0.75 - 0.1"], "c": "body"},
        {"p": "box", "size": [0.9, 0.1, 0.9], "at": [0, "-r-0.02", 0.3], "c": "#6b6e70"}
      ]}
    ]}
  ]
}
