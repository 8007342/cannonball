{
  "template": "stone_wall",
  "notes": "Dry-stone field wall segment along X; stones vary deterministically (no RNG) by index.",
  "view": {"pitch": 8, "yaw": 22},
  "params": {"L": 7, "h": 1.0, "rows": 3, "stone": "#9b958a", "stone2": "#8a8478", "cap": "#a8a296", "moss": "#7f8a5c"},
  "parts": [
    {"repeat": {"j": "range(rows)"}, "parts": [
      {"repeat": {"i": "range(int(L/0.55))"}, "let": {}, "p": "box",
       "size": ["0.5 + 0.08*sin(i*2.3 + j*1.7)", "0.55 - j*0.06 + 0.05*sin(i*1.3)", "h/rows*0.95 + 0.05*sin(i*3.1 + j)"],
       "at": ["-L/2 + 0.27 + i*0.55 + (0.25 if j % 2 else 0)", "0.03*sin(i*4.1 + j)", "j*h/rows"],
       "rot": ["3*sin(i*1.9)", "4*sin(i*2.7 + j*3.3)", "5*sin(i*1.1 + j)"],
       "c": "stone if (i*7 + j*3) % 5 else stone2", "if": "-L/2 + 0.27 + i*0.55 + (0.25 if j % 2 else 0) < L/2 - 0.2"}
    ]},
    {"repeat": {"i": "range(int(L/0.45))"}, "p": "box", "size": [0.42, 0.4, 0.22], "at": ["-L/2 + 0.22 + i*0.45", 0, "h"], "rot": [0, "6*sin(i*2.1)", "8*sin(i*1.4)"],
     "c": "moss if i % 4 == 1 else cap"}
  ]
}
