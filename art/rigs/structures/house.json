{
  "template": "house",
  "notes": "Generic detached house: farmhouse, ranch, Victorian, cottage by params. Front (porch, door) faces -Y, road side is -X.",
  "view": {"pitch": 7, "yaw": 35},
  "params": {"w": 10, "d": 7.5, "n": 2, "sh": 2.8, "roof": "gable", "rh": 2.6,
             "wall": "#f1ece0", "trim": "#ffffff", "roofc": "#5b5550", "doorc": "#7a3b2a", "glass": "#3d5068",
             "shutters": false, "shutterc": "#2f4a3a", "porch": true, "porch_w": 0.9, "chimney": true, "chimneyc": "#8b4a36",
             "garage": false, "garage_side": -1, "turret": false, "cross_gable": false, "siding": "boards"},
  "derived": {"fy": "-d/2", "H": "n*sh + 0.4", "ov": "0.45", "nw": "max(2, int(w/2.6))", "nsw": "max(1, int(d/3.2))",
              "door_k": "max(2, int(w/2.6))//2", "gw": "w*0.38"},
  "parts": [
    {"p": "box", "size": ["w+0.2", "d+0.2", 0.4], "c": "#8f8a83"},
    {"p": "box", "size": ["w", "d", "H-0.4"], "at": [0, 0, 0.4], "c": "wall"},
    {"p": "box", "size": ["w+0.08", "d+0.08", 0.16], "at": [0, 0, "H-0.16"], "c": "trim"},
    {"p": "box", "size": [0.18, 0.18, "H-0.4"], "at": ["w/2-0.05", "fy+0.05", 0.4], "c": "trim", "sym": "x"},

    {"if": "roof == 'gable'", "parts": [
      {"p": "prism", "axis": "x", "size": ["d", "w", "rh*0.97"], "at": [0, 0, "H"], "c": "wall"},
      {"p": "shell", "axis": "x", "depth": "w + 2*ov", "t": 0.2, "at": [0, 0, "H"],
       "profile": [["-(d/2+ov)", "-ov*2*rh/d"], [0, "rh+0.04"], ["d/2+ov", "-ov*2*rh/d"]], "c": "roofc"}
    ]},
    {"if": "roof == 'hip'", "p": "hip", "size": ["w+2*ov", "d+2*ov", "rh"], "at": [0, 0, "H-0.15"], "c": "roofc"},
    {"if": "roof == 'flat'", "parts": [
      {"p": "box", "size": ["w+0.1", "d+0.1", 0.6], "at": [0, 0, "H"], "c": "trim"}
    ]},

    {"repeat": {"s": "range(n)"}, "parts": [
      {"repeat": {"k": "range(nw)"}, "if": "not (s == 0 and k == door_k) and not (turret and k == 0)", "parts": [
        {"p": "box", "size": [1.3, 0.08, 1.7], "at": ["-w/2 + w*(k+0.5)/nw", "fy-0.03", "0.4 + s*sh + 0.75"], "c": "trim"},
        {"p": "box", "size": [1.05, 0.1, 1.45], "at": ["-w/2 + w*(k+0.5)/nw", "fy-0.06", "0.4 + s*sh + 0.87"], "c": "glass"},
        {"p": "box", "size": [0.06, 0.12, 1.45], "at": ["-w/2 + w*(k+0.5)/nw", "fy-0.08", "0.4 + s*sh + 0.87"], "c": "trim"},
        {"if": "shutters", "p": "box", "size": [0.42, 0.08, 1.6], "at": ["-w/2 + w*(k+0.5)/nw - 0.9", "fy-0.05", "0.4 + s*sh + 0.8"], "c": "shutterc"},
        {"if": "shutters", "p": "box", "size": [0.42, 0.08, 1.6], "at": ["-w/2 + w*(k+0.5)/nw + 0.9", "fy-0.05", "0.4 + s*sh + 0.8"], "c": "shutterc"}
      ]},
      {"repeat": {"k": "range(nsw)"}, "if": "not (garage and garage_side < 0)", "parts": [
        {"p": "box", "size": [0.08, 1.3, 1.7], "at": ["-w/2-0.03", "fy + d*(k+0.5)/nsw", "0.4 + s*sh + 0.75"], "c": "trim"},
        {"p": "box", "size": [0.1, 1.05, 1.45], "at": ["-w/2-0.06", "fy + d*(k+0.5)/nsw", "0.4 + s*sh + 0.87"], "c": "glass"}
      ]}
    ]},
    {"p": "box", "size": [1.4, 0.1, 2.4], "at": ["-w/2 + w*(door_k+0.5)/nw", "fy-0.03", 0.4], "c": "trim"},
    {"p": "box", "size": [1.0, 0.14, 2.1], "at": ["-w/2 + w*(door_k+0.5)/nw", "fy-0.06", 0.4], "c": "doorc"},

    {"if": "porch", "parts": [
      {"p": "box", "size": ["w*porch_w", 2.4, 0.42], "at": [0, "fy-1.2", 0], "c": "#b9b2a6"},
      {"p": "box", "size": [1.4, 0.9, 0.2], "at": ["-w/2 + w*(door_k+0.5)/nw", "fy-2.85", 0], "c": "#b9b2a6"},
      {"repeat": {"k": "range(int(w*porch_w/2.4)+1)"}, "p": "cyl", "r": 0.11, "h": 2.5, "seg": 8,
       "at": ["-w*porch_w/2 + 0.2 + k*(w*porch_w-0.4)/int(w*porch_w/2.4)", "fy-2.25", 0.42], "c": "trim"},
      {"p": "box", "size": ["w*porch_w", 0.08, 0.08], "at": [0, "fy-2.25", 1.25], "c": "trim"},
      {"p": "extrude", "axis": "x", "depth": "w*porch_w + 0.4", "at": [0, 0, 0],
       "profile": [["fy-2.6", 2.85], ["fy", 3.35], ["fy", 3.55], ["fy-2.6", 3.05]], "c": "roofc"}
    ]},
    {"if": "chimney", "p": "box", "size": [0.8, 0.8, "H + rh + 0.3"], "at": ["w*0.3", "d*0.12", 0], "c": "chimneyc"},
    {"if": "chimney", "p": "box", "size": [0.95, 0.95, 0.15], "at": ["w*0.3", "d*0.12", "H + rh + 0.3"], "c": "#5a4a44"},

    {"if": "garage", "parts": [
      {"p": "box", "size": [4.0, "d*0.9", 2.9], "at": ["garage_side*(w/2+2.0)", "d*0.05", 0], "c": "wall"},
      {"p": "box", "size": [3.0, 0.12, 2.2], "at": ["garage_side*(w/2+2.0)", "fy+d*0.05-0.06", 0], "c": "#e6e2da"},
      {"repeat": {"k": "range(4)"}, "p": "box", "size": [3.0, 0.16, 0.05], "at": ["garage_side*(w/2+2.0)", "fy+d*0.05-0.08", "0.5+k*0.5"], "c": "#bdb8ae"},
      {"p": "shell", "axis": "x", "depth": 4.6, "t": 0.18, "at": ["garage_side*(w/2+2.0)", "d*0.05", 2.9],
       "profile": [["-d*0.45-0.4", -0.25], [0, 1.4], ["d*0.45+0.4", -0.25]], "c": "roofc"},
      {"p": "prism", "axis": "x", "size": ["d*0.9", 4.0, 1.35], "at": ["garage_side*(w/2+2.0)", "d*0.05", 2.9], "c": "wall"}
    ]},

    {"if": "cross_gable", "parts": [
      {"p": "box", "size": ["gw", 1.4, "H-0.4"], "at": ["w*0.22", "fy-0.7", 0.4], "c": "wall"},
      {"p": "prism", "axis": "y", "size": ["gw", 1.6, "rh*1.1"], "at": ["w*0.22", "fy-0.6", "H"], "c": "wall"},
      {"p": "shell", "axis": "y", "depth": 2.2, "t": 0.2, "at": ["w*0.22", "fy-0.55", "H"],
       "profile": [["-gw/2-0.4", -0.35], [0, "rh*1.1+0.05"], ["gw/2+0.4", -0.35]], "c": "roofc"},
      {"p": "box", "size": [0.9, 0.1, 0.9], "at": ["w*0.22", "fy-1.43", "H+0.3"], "c": "glass"}
    ]},
    {"if": "turret", "parts": [
      {"p": "cyl", "r": 1.5, "h": "H+0.6", "seg": 10, "at": ["-w/2+0.4", "fy+0.3", 0], "c": "wall"},
      {"p": "cyl", "r": 1.75, "r2": 0, "h": 3.8, "seg": 10, "at": ["-w/2+0.4", "fy+0.3", "H+0.6"], "c": "roofc"},
      {"p": "cyl", "r": 1.6, "h": 0.18, "seg": 10, "at": ["-w/2+0.4", "fy+0.3", "H+0.45"], "c": "trim"},
      {"repeat": {"s": "range(n)"}, "p": "box", "size": [0.9, 0.12, 1.4], "at": ["-w/2+0.2", "fy-1.18", "0.4 + s*sh + 0.85"], "rot": [0, 0, -12], "c": "glass"},
      {"p": "cyl", "r": 0.05, "h": 0.9, "seg": 6, "at": ["-w/2+0.4", "fy+0.3", "H+4.3"], "c": "#3a3a3a"}
    ]}
  ]
}
