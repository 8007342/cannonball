      {"p": "box", "size": [0.62, 0.06, 1.4], "at": [0, 0.15, -0.1], "c": "#2a2c2e"},
      {"repeat": {"j": "[0, 1, 2]"}, "parts": [
        {"p": "cyl", "r": 0.13, "h": 0.06, "axis": "y", "seg": 14, "at": [0, -0.18, "0.98 - j*0.38"], "c": "['#e0362c', '#f2b630', '#3fbf6a'][j]"},
        {"p": "box", "size": [0.32, 0.22, 0.04], "at": [0, -0.27, "1.12 - j*0.38"], "c": "housing"}
      ]}
    ]},
    {"p": "box", "size": [0.35, 0.3, 0.55], "at": [0.25, -0.1, 2.4], "c": "housing"}
  ]
}
