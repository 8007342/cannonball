{
  "template": "utility_pole",
  "keep_rig": ["wire"],
  "notes": "Wooden utility pole, crossarm across the road axis, wires running along the road (Y) as short sagging stubs; optional transformer can.",
  "view": {"pitch": 6, "yaw": 30},
  "params": {"h": 10, "span": 5.5, "sag": 0.35, "wood": "#6e5236", "arm": "#7a5c3e", "wire": "#2a2a2a", "ins": "#7fa59a", "transformer": false, "arms": 1},
  "parts": [
    {"p": "cyl", "r": 0.16, "r2": 0.12, "h": "h", "seg": 12, "c": "wood"},
    {"repeat": {"a": "range(arms)"}, "parts": [
      {"p": "box", "size": [2.4, 0.12, 0.12], "at": [0, -0.16, "h-0.6-a*0.9"], "c": "arm"},
      {"repeat": {"x": "[-1.05, -0.4, 0.4, 1.05]"}, "parts": [
        {"p": "cyl", "r": 0.05, "h": 0.16, "seg": 8, "at": ["x", -0.16, "h-0.48-a*0.9"], "c": "ins"},
        {"p": "tube", "r": 0.018, "seg": 4, "path": "[(x, -0.16 + yy, h-0.33-a*0.9 - sag*(yy/span)**2) for yy in [span*(i/8-0.5)*2 for i in range(9)]]", "c": "wire"}
      ]},
      {"p": "beam", "from": [-0.7, -0.16, "h-0.62-a*0.9"], "to": [0, -0.16, "h-1.2-a*0.9"], "size": [0.05, 0.05], "c": "arm", "sym": "x"}
    ]},
    {"if": "transformer", "parts": [
      {"p": "cyl", "r": 0.32, "h": 0.9, "seg": 12, "at": [-0.4, 0, "h-3.2"], "c": "#8e979c"},
      {"p": "cyl", "r": 0.34, "h": 0.08, "seg": 12, "at": [-0.4, 0, "h-2.3"], "c": "#8e979c"}
    ]}
  ]
}
