{
  "template": "sign",
  "notes": "Road signs facing approaching traffic (-Y). style: speed | chevron | stop | yield | guide (green, blank, white arrow) | curve (yellow diamond with arrow).",
  "view": {"pitch": 5, "yaw": 14},
  "params": {"style": "speed", "post": "#9aa3a8", "white": "#f4f2ec", "black": "#1f1f1f", "yellow": "#f2c230", "red": "#c8302c", "green": "#1f6f4a", "ph": 2.1},
  "parts": [
    {"if": "style != 'guide'", "p": "box", "size": [0.08, 0.08, "ph+0.4"], "at": [0, 0.06, 0], "c": "post"},
    {"if": "style == 'speed'", "parts": [
      {"p": "box", "size": [0.76, 0.03, 0.96], "at": [0, 0, "ph-0.4"], "c": "white"},
      {"p": "box", "size": [0.68, 0.03, 0.88], "at": [0, -0.01, "ph-0.36"], "c": "white"},
      {"p": "box", "size": [0.7, 0.025, 0.02], "at": [0, -0.012, "ph+0.52"], "c": "black"},
      {"p": "box", "size": [0.7, 0.025, 0.02], "at": [0, -0.012, "ph-0.36"], "c": "black"},
      {"p": "box", "size": [0.02, 0.025, 0.9], "at": [-0.35, -0.012, "ph-0.37"], "c": "black", "sym": "x"}
    ]},
    {"if": "style == 'chevron'", "parts": [
      {"p": "box", "size": [0.62, 0.03, 0.78], "at": [0, 0, "ph-0.3"], "c": "yellow"},
      {"p": "extrude", "axis": "y", "depth": 0.03, "at": [0, -0.02, "ph+0.09"],
       "profile": [[0.12, -0.3], [-0.12, -0.3], [-0.05, 0], [-0.12, 0.3], [0.12, 0.3], [0.19, 0]], "c": "black"}
    ]},
    {"if": "style == 'curve'", "parts": [
      {"p": "box", "size": [0.72, 0.03, 0.72], "at": [0, 0, "ph+0.0"], "rot": [0, 45, 0], "c": "black"},
      {"p": "box", "size": [0.66, 0.03, 0.66], "at": [0, -0.01, "ph+0.04"], "rot": [0, 45, 0], "c": "yellow"},
      {"p": "tube", "r": 0.04, "seg": 6, "path": "[(-0.05 + 0.18*sin(t*pi), -0.03, ph+0.18 + 0.6*t) for t in [i/8 for i in range(9)]]", "c": "black"},
      {"p": "extrude", "axis": "y", "depth": 0.02, "at": [0, -0.03, 0], "profile": "[(-0.17, ph+0.74), (0.07, ph+0.74), (-0.05, ph+0.92)]", "c": "black"}
    ]},
    {"if": "style == 'stop'", "parts": [
      {"p": "cyl", "r": 0.42, "h": 0.03, "axis": "y", "seg": 8, "at": [0, 0, "ph+0.1"], "rot": [0, 22.5, 0], "c": "white"},
      {"p": "cyl", "r": 0.39, "h": 0.03, "axis": "y", "seg": 8, "at": [0, -0.012, "ph+0.1"], "rot": [0, 22.5, 0], "c": "red"}
    ]},
    {"if": "style == 'yield'", "parts": [
      {"p": "extrude", "axis": "y", "depth": 0.03, "at": [0, 0, "ph-0.3"], "profile": [[-0.45, 0.78], [0.45, 0.78], [0, 0]], "c": "red"},
      {"p": "extrude", "axis": "y", "depth": 0.03, "at": [0, -0.012, "ph-0.3"], "profile": [[-0.27, 0.66], [0.27, 0.66], [0, 0.2]], "c": "white"}
    ]},
    {"if": "style == 'guide'", "parts": [
      {"repeat": {"i": "[-1, 1]"}, "p": "box", "size": [0.16, 0.16, 4.6], "at": ["i*1.5", 0.12, 0], "c": "post"},
      {"p": "box", "size": [4.2, 0.06, 2.0], "at": [0, 0, 2.7], "c": "white"},
      {"p": "box", "size": [4.05, 0.06, 1.85], "at": [0, -0.02, 2.775], "c": "green"},
      {"p": "beam", "from": [1.3, -0.06, 3.1], "to": [1.3, -0.06, 4.1], "size": [0.14, 0.02], "c": "white"},
      {"p": "extrude", "axis": "y", "depth": 0.02, "at": [0, -0.07, 0], "profile": [[1.05, 4.0], [1.55, 4.0], [1.3, 4.35]], "c": "white"},
      {"p": "box", "size": [2.2, 0.02, 0.22], "at": [-0.5, -0.06, 3.85], "c": "#cfe3d6"},
      {"p": "box", "size": [1.6, 0.02, 0.22], "at": [-0.8, -0.06, 3.3], "c": "#cfe3d6"}
    ]}
  ]
}
